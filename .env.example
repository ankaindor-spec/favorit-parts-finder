# Публичный демонстрационный ключ из официального описания сервиса «Проценка»
# (PDF от 06.03.2023): https://lk.favorit-parts.ru/static/wsprice.pdf
# В примерах запросов указан key=00000000-0000-0000-0000-000000000001.
# Это не личный секрет. Переменные VITE_* вшиваются в клиентскую сборку.
VITE_FAVORIT_API_KEY=00000000-0000-0000-0000-000000000001
